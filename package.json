{
  "name": "mantou-blog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.11"
  },
  "description": "Browser-level acceptance tests for the mantou portfolio blog.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.js",
    "test:overview": "node --test tests/overview/*.test.mjs",
    "test:overview:e2e": "playwright test --config tests/overview/playwright.config.cjs",
    "build:analytics": "node scripts/build_analytics.mjs",
    "test:feedback": "node --experimental-vm-modules --test tests/node/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "wrangler": "4.146.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
